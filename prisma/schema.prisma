generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id            String   @id @default(cuid())
  name          String
  cuisines      String[]
  avgPrice      Int?
  location      Json
  noiseLevel    String?
  accessibility String[]
  availability  Availability[]
  reservations  Reservation[]
}

model Availability {
  id           String   @id @default(cuid())
  restaurantId String
  date         DateTime
  slot         String
  capacity     Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Reservation {
  id           String   @id @default(cuid())
  restaurantId String
  date         DateTime
  slot         String
  partySize    Int
  note         String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
